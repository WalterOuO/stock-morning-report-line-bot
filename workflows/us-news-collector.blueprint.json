{
    "name": "美股新聞蒐集scenario",
    "flow": [
        {
            "id": 1,
            "module": "rss:ActionReadArticles",
            "version": 4,
            "parameters": {
                "include": []
            },
            "mapper": {
                "url": "https://news.cnyes.com/rss/v1/news/category/wd_stock",
                "gzip": true,
                "password": "",
                "username": "",
                "maxResults": "100",
                "filterDateTo": "",
                "filterDateFrom": ""
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "美股RSS"
                },
                "restore": {},
                "parameters": [
                    {
                        "name": "include",
                        "type": "select",
                        "label": "Process RSS fields",
                        "multiple": true,
                        "validate": {
                            "enum": [
                                "google-merchant-center",
                                "itunes"
                            ]
                        }
                    }
                ],
                "expect": [
                    {
                        "name": "url",
                        "type": "url",
                        "label": "URL",
                        "required": true
                    },
                    {
                        "name": "username",
                        "type": "text",
                        "label": "User name"
                    },
                    {
                        "name": "password",
                        "type": "password",
                        "label": "Password"
                    },
                    {
                        "name": "filterDateFrom",
                        "type": "date",
                        "label": "Date from"
                    },
                    {
                        "name": "filterDateTo",
                        "type": "date",
                        "label": "Date to "
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of returned items",
                        "required": true
                    },
                    {
                        "name": "gzip",
                        "type": "boolean",
                        "label": "Request compressed content",
                        "required": true
                    }
                ],
                "interface": [
                    {
                        "name": "title",
                        "type": "text",
                        "label": "Title"
                    },
                    {
                        "name": "description",
                        "type": "text",
                        "label": "Description"
                    },
                    {
                        "name": "summary",
                        "type": "text",
                        "label": "Summary"
                    },
                    {
                        "name": "author",
                        "type": "text",
                        "label": "Author"
                    },
                    {
                        "name": "url",
                        "type": "url",
                        "label": "URL"
                    },
                    {
                        "name": "dateUpdated",
                        "type": "date",
                        "label": "Date updated"
                    },
                    {
                        "name": "dateCreated",
                        "type": "date",
                        "label": "Date created"
                    },
                    {
                        "name": "comments",
                        "type": "url",
                        "label": "Comments"
                    },
                    {
                        "name": "image",
                        "spec": [
                            {
                                "name": "title",
                                "type": "text",
                                "label": "Name"
                            },
                            {
                                "name": "url",
                                "type": "url",
                                "label": "URL"
                            }
                        ],
                        "type": "collection",
                        "label": "Image"
                    },
                    {
                        "name": "categories",
                        "spec": {
                            "type": "text"
                        },
                        "type": "array",
                        "label": "Categories"
                    },
                    {
                        "name": "source",
                        "spec": [
                            {
                                "name": "title",
                                "type": "text",
                                "label": "Name"
                            },
                            {
                                "name": "url",
                                "type": "url",
                                "label": "URL"
                            }
                        ],
                        "type": "collection",
                        "label": "Source"
                    },
                    {
                        "name": "enclosures",
                        "spec": [
                            {
                                "name": "url",
                                "type": "url",
                                "label": "URL"
                            },
                            {
                                "name": "type",
                                "type": "text",
                                "label": "Type"
                            },
                            {
                                "name": "length",
                                "type": "number",
                                "label": "Length"
                            }
                        ],
                        "type": "array",
                        "label": "Enclosures"
                    },
                    {
                        "help": "Other RSS fields. All values are in text format.",
                        "name": "rssFields",
                        "spec": [
                            {
                                "name": "title",
                                "type": "text",
                                "label": "title"
                            },
                            {
                                "name": "category",
                                "type": "text",
                                "label": "category"
                            },
                            {
                                "name": "link",
                                "type": "text",
                                "label": "link"
                            },
                            {
                                "name": "guid",
                                "type": "text",
                                "label": "guid"
                            },
                            {
                                "name": "description",
                                "type": "text",
                                "label": "description"
                            },
                            {
                                "name": "pubdate",
                                "type": "text",
                                "label": "pubdate"
                            },
                            {
                                "name": "media:thumbnail",
                                "spec": [
                                    {
                                        "name": "props",
                                        "spec": [
                                            {
                                                "name": "url",
                                                "type": "text",
                                                "label": "url"
                                            },
                                            {
                                                "name": "height",
                                                "type": "number",
                                                "label": "height"
                                            },
                                            {
                                                "name": "width",
                                                "type": "number",
                                                "label": "width"
                                            },
                                            {
                                                "name": "caption",
                                                "type": "text",
                                                "label": "caption"
                                            }
                                        ],
                                        "type": "collection",
                                        "label": "Properties"
                                    },
                                    {
                                        "name": "value",
                                        "type": "text",
                                        "label": "Value"
                                    }
                                ],
                                "type": "collection",
                                "label": "media:thumbnail"
                            },
                            {
                                "name": "media:keywords",
                                "spec": [
                                    {
                                        "name": "props",
                                        "spec": [],
                                        "type": "collection",
                                        "label": "Properties"
                                    },
                                    {
                                        "name": "value",
                                        "type": "text",
                                        "label": "Value"
                                    }
                                ],
                                "type": "collection",
                                "label": "media:keywords"
                            }
                        ],
                        "type": "collection",
                        "label": "RSS fields"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "jina-ai:readURL",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 12157441
            },
            "filter": {
                "name": "美股盤後",
                "conditions": [
                    [
                        {
                            "a": "{{parseDate(1.rssFields.pubdate; \"ddd, DD MMM YYYY HH:mm:ss ZZ\")}}",
                            "b": "{{parseDate(formatDate(now; \"YYYY-MM-DD 04:00:00\"); \"YYYY-MM-DD HH:mm:ss\"; \"Asia/Taipei\")}}",
                            "o": "number:greater"
                        },
                        {
                            "a": "{{1.rssFields.title}}",
                            "b": "速報",
                            "o": "text:notcontain"
                        },
                        {
                            "a": "{{1.rssFields.title}}",
                            "b": "美股盤後",
                            "o": "text:contain"
                        }
                    ]
                ]
            },
            "mapper": {
                "url": "{{ifempty(1.url; 1.rssFields.link)}}",
                "Accept": "application/json",
                "X-Return-Format": "markdown"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "Accept": {
                            "mode": "chose",
                            "label": "JSON Response"
                        },
                        "X-Locale": {
                            "mode": "chose",
                            "label": "Empty"
                        },
                        "X-No-Gfm": {
                            "mode": "chose",
                            "label": "Empty"
                        },
                        "X-With-Iframe": {
                            "mode": "chose"
                        },
                        "X-Retain-Images": {
                            "mode": "chose",
                            "label": "Empty"
                        },
                        "X-Return-Format": {
                            "mode": "chose",
                            "label": "markdown"
                        },
                        "X-With-Shadow-Dom": {
                            "mode": "chose"
                        },
                        "X-With-Links-Summary": {
                            "mode": "chose"
                        },
                        "X-With-Images-Summary": {
                            "mode": "chose"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "jina-ai"
                            },
                            "label": "VeryGood's jina.ai connection"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:jina-ai",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "url",
                        "type": "text",
                        "label": "URL to Read",
                        "required": true
                    },
                    {
                        "name": "X-Return-Format",
                        "type": "select",
                        "label": "Content Format",
                        "validate": {
                            "enum": [
                                "markdown",
                                "html",
                                "text",
                                "screenshot",
                                "pageshot"
                            ]
                        }
                    },
                    {
                        "name": "X-Timeout",
                        "type": "text",
                        "label": "Timeout"
                    },
                    {
                        "name": "X-Target-Selector",
                        "type": "text",
                        "label": "Target Selector"
                    },
                    {
                        "name": "X-Wait-For-Selector",
                        "type": "text",
                        "label": "Wait For Selector"
                    },
                    {
                        "name": "X-Remove-Selector",
                        "type": "text",
                        "label": "Excluded Selector"
                    },
                    {
                        "name": "X-Retain-Images",
                        "type": "select",
                        "label": "Remove All Images",
                        "validate": {
                            "enum": [
                                "none"
                            ]
                        }
                    },
                    {
                        "name": "X-With-Links-Summary",
                        "type": "boolean",
                        "label": "Gather All Links At the End"
                    },
                    {
                        "name": "X-With-Images-Summary",
                        "type": "boolean",
                        "label": "Gather All Images At the End"
                    },
                    {
                        "name": "Accept",
                        "type": "select",
                        "label": "Accept Response",
                        "validate": {
                            "enum": [
                                "application/json",
                                "text/event-stream"
                            ]
                        }
                    },
                    {
                        "name": "X-Set-Cookie",
                        "type": "text",
                        "label": "Forward Cookie"
                    },
                    {
                        "name": "X-With-Generated-Alt",
                        "type": "text",
                        "label": "Image Caption"
                    },
                    {
                        "name": "X-Proxy-Url",
                        "type": "url",
                        "label": "Use a Proxy Server"
                    },
                    {
                        "name": "X-No-Cache",
                        "type": "text",
                        "label": "Bypass the Cache"
                    },
                    {
                        "name": "X-No-Gfm",
                        "type": "select",
                        "label": "Github Flavored Markdown",
                        "validate": {
                            "enum": [
                                "table",
                                "true"
                            ]
                        }
                    },
                    {
                        "name": "X-Locale",
                        "type": "select",
                        "label": "Browser Locale",
                        "validate": {
                            "enum": [
                                "taben-USle"
                            ]
                        }
                    },
                    {
                        "name": "X-With-Iframe",
                        "type": "boolean",
                        "label": "Enable iframe Extraction"
                    },
                    {
                        "name": "X-With-Shadow-Dom",
                        "type": "boolean",
                        "label": "Enable Shadow DOM Extraction"
                    }
                ]
            },
            "onerror": [
                {
                    "id": 4,
                    "module": "builtin:Ignore",
                    "version": 1,
                    "metadata": {
                        "designer": {
                            "x": 299,
                            "y": 268
                        }
                    }
                }
            ]
        },
        {
            "id": 5,
            "module": "regexp:Replace",
            "version": 1,
            "parameters": {},
            "mapper": {
                "text": "{{2.response.data.content}}",
                "value": " ",
                "global": false,
                "pattern": "^[\\s\\S]*?\\n(?=# )",
                "multiline": false,
                "sensitive": true,
                "singleline": false
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0,
                    "name": "去除標題前網頁按鈕"
                }
            }
        },
        {
            "id": 6,
            "module": "regexp:Replace",
            "version": 1,
            "parameters": {},
            "mapper": {
                "text": "{{5.text}}",
                "value": " ",
                "global": true,
                "pattern": "^[ \\t]*!\\[Image[^\\n]*\\n?",
                "multiline": true,
                "sensitive": true,
                "singleline": false
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0,
                    "name": "去除圖片連結"
                }
            }
        },
        {
            "id": 7,
            "module": "regexp:Replace",
            "version": 1,
            "parameters": {},
            "mapper": {
                "text": "{{6.text}}",
                "value": " ",
                "global": false,
                "pattern": "\\*\\s+掌握全球財經資訊[\\s\\S]*$",
                "multiline": false,
                "sensitive": true,
                "singleline": false
            },
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 0,
                    "name": "去除結尾其他新聞"
                }
            }
        },
        {
            "id": 3,
            "module": "datastore:AddRecord",
            "version": 1,
            "parameters": {
                "datastore": 196802
            },
            "mapper": {
                "key": "{{md5(ifempty(1.url; 1.rssFields.link))}}",
                "data": {
                    "link": "{{ifempty(1.url; 1.rssFields.link)}}",
                    "title": "{{1.title}}",
                    "market": "us",
                    "content": "{{trim(substring(7.text; 0; 8000))}}",
                    "pubdate": "{{parseDate(1.rssFields.pubdate; \"ddd, DD MMM YYYY HH:mm:ss ZZ\")}}"
                },
                "overwrite": true
            },
            "metadata": {
                "designer": {
                    "x": 1500,
                    "y": -1,
                    "name": "Data store寫入us類別"
                },
                "restore": {
                    "expect": {
                        "overwrite": {
                            "mode": "chose"
                        }
                    },
                    "parameters": {
                        "datastore": {
                            "label": "cnyes_articles"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "datastore",
                        "type": "datastore",
                        "label": "Data store",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "key",
                        "type": "text",
                        "label": "Key"
                    },
                    {
                        "name": "overwrite",
                        "type": "boolean",
                        "label": "Overwrite an existing record",
                        "required": true
                    },
                    {
                        "name": "data",
                        "spec": [
                            {
                                "name": "market",
                                "type": "text",
                                "label": null
                            },
                            {
                                "name": "title",
                                "type": "text",
                                "label": null
                            },
                            {
                                "name": "pubdate",
                                "type": "date",
                                "label": null
                            },
                            {
                                "name": "link",
                                "type": "text",
                                "label": null
                            },
                            {
                                "name": "content",
                                "type": "text",
                                "label": null
                            }
                        ],
                        "type": "collection",
                        "label": "Record"
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": []
    }
}